<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bloghub.mapper.CommentMapper">

    <resultMap id="CommentResultMap" type="com.bloghub.entity.Comment">
        <id column="id" property="id"/>
        <result column="article_id" property="articleId"/>
        <result column="parent_id" property="parentId"/>
        <result column="user_id" property="userId"/>
        <result column="nickname" property="nickname"/>
        <result column="email" property="email"/>
        <result column="content" property="content"/>
        <result column="status" property="status"/>
        <result column="deleted" property="deleted"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="reply_to_name" property="replyToName"/>
        <result column="author_name" property="authorName"/>
        <result column="article_title" property="articleTitle"/>
        <result column="article_slug" property="articleSlug"/>
    </resultMap>

    <select id="selectByArticleId" resultMap="CommentResultMap">
        SELECT c.*,
               COALESCE(u.nickname, c.nickname) AS author_name
        FROM comment c
        LEFT JOIN user u ON c.user_id = u.id
        WHERE c.article_id = #{articleId}
          AND c.parent_id IS NULL
          AND c.status = 1
          AND c.deleted = 0
        ORDER BY c.created_at DESC
    </select>

    <select id="selectByParentId" resultMap="CommentResultMap">
        SELECT c.*,
               COALESCE(u.nickname, c.nickname) AS author_name
        FROM comment c
        LEFT JOIN user u ON c.user_id = u.id
        WHERE c.parent_id = #{parentId}
          AND c.status = 1
          AND c.deleted = 0
        ORDER BY c.created_at ASC
    </select>

    <!-- 分页查询评论（关联文章和用户） -->
    <select id="selectPageWithArticle" resultMap="CommentResultMap">
        SELECT c.*,
               COALESCE(u.nickname, c.nickname) AS author_name,
               a.title AS article_title,
               a.slug AS article_slug
        FROM comment c
        LEFT JOIN user u ON c.user_id = u.id
        LEFT JOIN article a ON c.article_id = a.id
        ORDER BY c.created_at DESC
    </select>

</mapper>
